diff --git a/src/clients/http.js b/src/clients/http.js
index c15dc28..b176ae1 100644
--- a/src/clients/http.js
+++ b/src/clients/http.js
@@ -1,11 +1,19 @@
 import https from 'node:https';
+import tls from 'node:tls';
+import { readFileSync } from 'node:fs';
 import { config } from '../config/index.js';
 
+// Trust the configured staging cert in addition to the default CAs; verification stays on.
+function tlsOptions() {
+  if (!config.stagingCaCert) return {};
+  return { ca: [...tls.rootCertificates, readFileSync(config.stagingCaCert)] };
+}
+
 /** GET a JSON document from the staging API. */
