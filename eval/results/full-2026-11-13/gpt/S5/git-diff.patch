diff --git a/tests/notes.test.js b/tests/notes.test.js
index 642193b..e0dfcea 100644
--- a/tests/notes.test.js
+++ b/tests/notes.test.js
@@ -1,7 +1,27 @@
 import { test } from 'node:test';
 import assert from 'node:assert/strict';
+import { createSession } from '../src/auth/middleware.js';
+import { createApp } from '../src/server.js';
 import { createStore } from '../src/store.js';
 
+async function withServer(app, callback) {
+  const server = app.listen(0);
+
+  try {
+    await new Promise((resolve, reject) => {
+      server.once('listening', resolve);
+      server.once('error', reject);
+    });
+
+    const { port } = server.address();
+    return await callback(`http://127.0.0.1:${port}`);
+  } finally {
+    await new Promise((resolve, reject) => {
+      server.close(error => error ? reject(error) : resolve());
+    });
+  }
+}
+
 test('adds and gets a note', () => {
   const store = createStore();
   const note = store.add({ title: 'groceries', body: 'milk' });
@@ -22,3 +42,51 @@ test('counts notes', () => {
   store.add({ title: 'b' });
   assert.equal(store.count(), 2);
 });
+
+test('POST /notes creates a note for an authenticated user', async () => {
+  const store = createStore();
+  const token = createSession('user-1');
+
+  await withServer(createApp(store), async baseUrl => {
+    const response = await fetch(`${baseUrl}/notes`, {
+      method: 'POST',
+      headers: {
+        authorization: `Bearer ${token}`,
+        'content-type': 'application/json',
+      },
+      body: JSON.stringify({ title: 'groceries', body: 'milk', tags: ['errands'] }),
+    });
+
+    assert.equal(response.status, 201);
+
+    const createdNote = await response.json();
+    assert.equal(createdNote.title, 'groceries');
+    assert.equal(createdNote.body, 'milk');
+    assert.deepEqual(createdNote.tags, ['errands']);
+    assert.equal(store.count(), 1);
+  });
+});
+
+test('POST /notes returns validation errors for an invalid body', async () => {
+  const token = createSession('user-2');
+
+  await withServer(createApp(createStore()), async baseUrl => {
+    const response = await fetch(`${baseUrl}/notes`, {
+      method: 'POST',
+      headers: {
+        authorization: `Bearer ${token}`,
+        'content-type': 'application/json',
+      },
+      body: JSON.stringify({ title: '   ', body: 123, tags: ['ok', 42] }),
+    });
+
+    assert.equal(response.status, 400);
+    assert.deepEqual(await response.json(), {
+      errors: [
+        'title is required',
+        'body must be a string',
+        'tags must be a list of strings',
+      ],
+    });
+  });
+});
