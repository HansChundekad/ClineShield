diff --git a/tests/paginate.test.js b/tests/paginate.test.js
index 133996a..db8d34f 100644
--- a/tests/paginate.test.js
+++ b/tests/paginate.test.js
@@ -6,6 +6,23 @@ test('first page starts at the first item', () => {
   assert.equal(paginate(['a', 'b', 'c'], 1, 2)[0], 'a');
 });
 
+test('each page includes its last item', () => {
+  assert.deepEqual(paginate(['a', 'b', 'c', 'd'], 1, 2), ['a', 'b']);
+  assert.deepEqual(paginate(['a', 'b', 'c', 'd'], 2, 2), ['c', 'd']);
+});
+
+test('last partial page returns the remaining items', () => {
+  assert.deepEqual(paginate(['a', 'b', 'c', 'd', 'e'], 3, 2), ['e']);
+});
+
+test('pages together cover every item exactly once', () => {
+  const items = Array.from({ length: 7 }, (_, i) => i);
+  const size = 3;
+  const seen = [];
+  for (let p = 1; p <= pageCount(items.length, size); p++) seen.push(...paginate(items, p, size));
+  assert.deepEqual(seen, items);
+});
+
 test('page past the end is empty', () => {
   assert.deepEqual(paginate(['a', 'b'], 5, 2), []);
 });
