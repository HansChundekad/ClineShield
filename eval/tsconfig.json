{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "types": ["node", "jest"],
    "typeRoots": ["../clineshield/node_modules/@types"]
  },
  "include": ["src/**/*", "../clineshield/src/plugin/**/*"]
}
